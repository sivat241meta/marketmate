 "turns": [
  {
   "id": 1,
   "start_ms": 380,
   "end_ms": 12620,
   "text": "so, sev vazhaiwazhai இன்னைக்கு rate நூற்றி பத்து ரூபா கிலோ. நேந்திரன் நூறு ரூபா. கற்பூரவள்ளி எண்பது பச்சை பழம் அம்பது ரூபா கிலோ"
  },
  {
   "id": 2,
   "start_ms": 14220,
   "end_ms": 36460,
   "text": "தற்பூசணி கிலோ முப்பது ஏலகி கிலோ நூற்றி இருபது பூசணி ஒரு கிலோ முப்பது ரூபா கத்தரிக்கா கால் கிலோ இருபது ரூபா அவரக்கா கால் கிலோ முப்பத்தஞ்சு கேரட் கால் கிலோ இருபது ரூபா beans கால் கிலோ முப்பத்தஞ்சு"
  },
  {
   "id": 3,
   "start_ms": 39020,
   "end_ms": 41340,
   "text": "மன்னூர்ல இன்னைக்கு ரேட்டு எழுபது ஒரு கிலோ."
  },
  {
   "id": 4,
   "start_ms": 43180,
   "end_ms": 44860,
   "text": "சுரக்கா ஒரு கிலோ அறுபது ரூபா."
  },
  {
   "id": 5,
   "start_ms": 46780,
   "end_ms": 48380,
   "text": "பொடலங்கா ஒரு கிலோ கிலோ எழுபது ரூபா."
  },
  {
   "id": 6,
   "start_ms": 51020,
   "end_ms": 52780,
   "text": "வெண்டைக்கா ஒரு கிலோ அறுபது."
  },
  {
   "id": 7,
   "start_ms": 54540,
   "end_ms": 56300,
   "text": "குடமுளகா ஒரு கிலோ நூறு."
  },
  {
   "id": 8,
   "start_ms": 58460,
   "end_ms": 60220,
   "text": "வெள்ளரிக்கா ஒரு கிலோ அறுபது."
  }
 ],
