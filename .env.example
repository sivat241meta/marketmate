MODEL_API_KEY=
BASETEN_API_KEY=
TEXT_PROVIDER=meta
DAILY_BUDGET_USD=3
PUBLIC_BASE_URL=
# Local data dir for the SQLite db, photos, clips and cost ledger.
DATA_DIR=
# Set to 0 to hide the labelled sample shops without deleting them.
SAMPLE_SHOPS=
# Set to 1 to show rarely used extras (purchases, stock photo counts,
# helpers, POS CSV, shelf tags). Default off: core story + Bills + Excel.
SHOW_EXTRAS=
# Server-side sample stall video for the judge test page (/try). The file
# lives only on the server, never in git. Default:
# DATA_DIR/samples/judge-sample.mp4 (the sample button hides when missing).
JUDGE_SAMPLE_VIDEO=
